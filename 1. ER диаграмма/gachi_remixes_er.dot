graph ER {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.9, fontname="DejaVu Sans",
         fontsize=10, bgcolor="white", pad=0.3];
  node  [fontname="DejaVu Sans", fontsize=9];
  edge  [fontname="DejaVu Sans", fontsize=8];

  // ============================================================
  // СУЩНОСТИ
  // ============================================================
  USER     [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="USER"];
  REMIXER  [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="REMIXER"];
  SINGER   [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="SINGER"];
  ORIGINAL [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="ORIGINAL"];
  REMIX    [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="REMIX"];
  PLAYLIST [shape=box, style=filled, fillcolor="#DDEBF7", width=1.2, height=0.55, label="PLAYLIST"];
  VIEW     [shape=box, style=filled, fillcolor="#DDEBF7", width=1.0, height=0.55, label="VIEW"];
  ALBUM    [shape=box, style=filled, fillcolor="#DDEBF7", width=1.0, height=0.55, label="ALBUM"];
  TAG      [shape=box, style=filled, fillcolor="#DDEBF7", width=1.0, height=0.55, label="TAG"];
  CHART    [shape=box, style=filled, fillcolor="#DDEBF7", width=1.0, height=0.55, label="CHART"];
  COMMENT  [shape=box, style=filled, fillcolor="#DDEBF7", width=1.1, height=0.55, label="COMMENT"];
  LIKE     [shape=box, style=filled, fillcolor="#DDEBF7", width=1.0, height=0.55, label="LIKE"];

  // ============================================================
  // СВЯЗИ
  // ============================================================
  R_create     [shape=diamond, style=filled, fillcolor="#FCE4D6", label="создаёт",      width=1.1, height=0.7];
  R_watch      [shape=diamond, style=filled, fillcolor="#FCE4D6", label="слушает",      width=1.0, height=0.7];
  R_ref        [shape=diamond, style=filled, fillcolor="#FCE4D6", label="относится к",  width=1.2, height=0.7];
  R_cons       [shape=diamond, style=filled, fillcolor="#FCE4D6", label="состоит из",   width=1.1, height=0.7];
  R_in         [shape=diamond, style=filled, fillcolor="#FCE4D6", label="включает",     width=1.1, height=0.7];
  R_rec        [shape=diamond, style=filled, fillcolor="#FCE4D6", label="записывает",   width=1.1, height=0.7];
  R_perform    [shape=diamond, style=filled, fillcolor="#FCE4D6", label="исполняет",    width=1.1, height=0.7];
  R_remixof    [shape=diamond, style=filled, fillcolor="#FCE4D6", label="основа для",    width=1.1, height=0.7];
  R_tag        [shape=diamond, style=filled, fillcolor="#FCE4D6", label="помечен",      width=1.0, height=0.7];
  R_place      [shape=diamond, style=filled, fillcolor="#FCE4D6", label="занимает",     width=1.0, height=0.7];
  R_write      [shape=diamond, style=filled, fillcolor="#FCE4D6", label="пишет",        width=1.0, height=0.7];
  R_about      [shape=diamond, style=filled, fillcolor="#FCE4D6", label="о",            width=0.9, height=0.7];
  R_reply      [shape=diamond, style=filled, fillcolor="#FCE4D6", label="ответ на",     width=1.0, height=0.7];
  R_set        [shape=diamond, style=filled, fillcolor="#FCE4D6", label="ставит",       width=1.0, height=0.7];
  R_get        [shape=diamond, style=filled, fillcolor="#FCE4D6", label="получает",     width=1.0, height=0.7];
  R_tag_create [shape=diamond, style=filled, fillcolor="#FCE4D6", label="создаёт",      width=1.0, height=0.7];

  // ============================================================
  // АТРИБУТЫ  (PK — подчёркнут, FK — пунктирный овал)
  // ============================================================
  // --- USER ---
  U_id   [shape=ellipse, label=<<u>id</u>>];
  U_name [shape=ellipse, label="name"];
  U_pass [shape=ellipse, label="pass_hash"];
  U_role [shape=ellipse, label="role"];
  USER -- U_id; USER -- U_name; USER -- U_pass; USER -- U_role;

  // --- REMIXER ---
  Rm_id   [shape=ellipse, label=<<u>id</u>>];
  Rm_name [shape=ellipse, label="name"];
  Rm_age  [shape=ellipse, label="age"];
  Rm_reg  [shape=ellipse, label="registered_at"];
  REMIXER -- Rm_id; REMIXER -- Rm_name;
  REMIXER -- Rm_age; REMIXER -- Rm_reg;

  // --- SINGER ---
  S_id      [shape=ellipse, label=<<u>id</u>>];
  S_name    [shape=ellipse, label="name"];
  S_age     [shape=ellipse, label="age"];
  S_genre   [shape=ellipse, label="genre"];
  S_country [shape=ellipse, label="country"];
  SINGER -- S_id; SINGER -- S_name; SINGER -- S_age;
  SINGER -- S_genre; SINGER -- S_country;

  // --- ORIGINAL ---
  O_id    [shape=ellipse, label=<<u>id</u>>];
  O_title [shape=ellipse, label="title"];
  O_sing  [shape=ellipse, label="singer_id",    style=dashed];
  O_year  [shape=ellipse, label="release_year"];
  ORIGINAL -- O_id; ORIGINAL -- O_title;
  ORIGINAL -- O_sing; ORIGINAL -- O_year;

  // --- REMIX ---
  Rx_id      [shape=ellipse, label=<<u>id</u>>];
  Rx_orig    [shape=ellipse, label="original_id", style=dashed];
  Rx_preview [shape=ellipse, label="preview"];
  REMIX -- Rx_id; REMIX -- Rx_orig; REMIX -- Rx_preview;

  // --- PLAYLIST ---
  P_id      [shape=ellipse, label=<<u>id</u>>];
  P_title   [shape=ellipse, label="title"];
  P_created [shape=ellipse, label="created_at"];
  P_public  [shape=ellipse, label="is_public"];
  PLAYLIST -- P_id; PLAYLIST -- P_title; PLAYLIST -- P_created; PLAYLIST -- P_public;

  // --- VIEW ---
  V_id     [shape=ellipse, label=<<u>id</u>>];
  V_user   [shape=ellipse, label="user_id",  style=dashed];
  V_remix  [shape=ellipse, label="remix_id", style=dashed];
  V_viewed [shape=ellipse, label="viewed_at"];
  VIEW -- V_id; VIEW -- V_user; VIEW -- V_remix; VIEW -- V_viewed;

  // --- ALBUM ---
  A_id    [shape=ellipse, label=<<u>id</u>>];
  A_title [shape=ellipse, label="title"];
  A_year  [shape=ellipse, label="year"];
  ALBUM -- A_id; ALBUM -- A_title; ALBUM -- A_year;

  // --- TAG ---
  T_id      [shape=ellipse, label=<<u>id</u>>];
  T_label   [shape=ellipse, label="label"];
  T_created [shape=ellipse, label="created_at"];
  T_creator [shape=ellipse, label="creator_id", style=dashed];
  TAG -- T_id; TAG -- T_label; TAG -- T_created; TAG -- T_creator;

  // --- CHART ---
  C_rid   [shape=ellipse, label=<<u>remix_id</u>>, style=dashed];
  C_place [shape=ellipse, label="place"];
  C_views [shape=ellipse, label="views"];
  CHART -- C_rid; CHART -- C_place; CHART -- C_views;

  // --- COMMENT ---
  Cm_id      [shape=ellipse, label=<<u>id</u>>];
  Cm_text    [shape=ellipse, label="text"];
  Cm_created [shape=ellipse, label="created_at"];
  COMMENT -- Cm_id; COMMENT -- Cm_text; COMMENT -- Cm_created;

  // --- LIKE ---
  L_id      [shape=ellipse, label=<<u>id</u>>];
  L_created [shape=ellipse, label="created_at"];
  LIKE -- L_id; LIKE -- L_created;

  // ============================================================
  // СВЯЗИ С КРАТНОСТЯМИ
  // ============================================================
  USER     -- R_create     [label="1"];
  R_create -- PLAYLIST     [label="N"];

  USER     -- R_watch      [label="1"];
  R_watch  -- VIEW         [label="N"];

  VIEW     -- R_ref        [label="N"];
  R_ref    -- REMIX        [label="1"];

  PLAYLIST -- R_cons       [label="1"];
  R_cons   -- REMIX        [label="N"];

  ALBUM    -- R_in         [label="1"];
  R_in     -- REMIX        [label="N"];

  REMIXER  -- R_rec        [label="1"];
  R_rec    -- REMIX        [label="N"];

  SINGER   -- R_perform    [label="1"];
  R_perform -- ORIGINAL    [label="N"];

  ORIGINAL -- R_remixof    [label="1"];
  R_remixof -- REMIX       [label="N"];

  REMIX    -- R_tag        [label="N"];
  R_tag    -- TAG          [label="M"];

  REMIX    -- R_place      [label="1"];
  R_place  -- CHART        [label="1"];

  USER     -- R_write      [label="1"];
  R_write  -- COMMENT      [label="N"];

  COMMENT  -- R_about      [label="N"];
  R_about  -- REMIX        [label="1"];

  COMMENT  -- R_reply      [label="1"];
  R_reply  -- COMMENT      [label="N"];

  USER     -- R_set        [label="1"];
  R_set    -- LIKE         [label="N"];

  LIKE     -- R_get        [label="N"];
  R_get    -- REMIX        [label="1"];

  USER     -- R_tag_create [label="1"];
  R_tag_create -- TAG      [label="N"];
}